# ==== Sistema da Biblioteca — Variáveis de ambiente ====
# Copie este arquivo para ".env" (ex.: Copy-Item .env.example .env) e preencha os valores.
# NUNCA commite o arquivo .env real (veja .gitignore).

# Porta do servidor Express
PORT=3000

# Secret da sessão (obrigatório em produção). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Origens permitidas (CORS), separadas por vírgula
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# URL base pública do sistema (usada no callback do Google)
BASE_URL=http://localhost:3000

# ==== Login com Google (OAuth 2.0) ====
# Crie as credenciais em https://console.cloud.google.com/apis/credentials
# Tipo: "ID do cliente OAuth" > "Aplicativo da Web"
# Em "URIs de redirecionamento autorizados", cadastre exatamente:
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: sobrescreve o callback (por padrão é BASE_URL + /api/auth/google/callback)
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Ambiente (em produção use "production" — cookies ficam secure)
NODE_ENV=development
