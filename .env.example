# ==== Sistema da Biblioteca — Variáveis de ambiente ====
# Copie este arquivo para ".env" (ex.: Copy-Item .env.example .env) e preencha os valores.
# NUNCA commite o arquivo .env real (veja .gitignore).
# Na escola (uso local): NENHUMA variável é obrigatória — tudo tem padrão seguro.
# SESSION_SECRET ausente = gera `.session-secret` local (ok); em produção use
# variável forte + NODE_ENV=production (cookies passam a `secure`).

# Porta do servidor Express (padrão 3000; se ocupada use 3001)
PORT=3000

# Secret da sessão (obrigatório em produção). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Origens permitidas (CORS), separadas por vírgula
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Ambiente (em produção use "production" — cookies ficam secure)
NODE_ENV=development

# ==== LEGADO (Etapa 12): OAuth Google removido na Etapa 5 ====
# As variáveis abaixo NÃO são mais usadas pelo código (sem GOOGLE_* no fonte).
# Mantidas aqui só como referência histórica — pode removê-las.
# URL base pública do sistema (usada no callback do Google)
# BASE_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
